+.anime-character--ania{justify-content:flex-end;transform-origin:bottom right}
+.anime-character--karol{justify-content:flex-start;transform-origin:bottom left}
+.anime-character--karol img{transform:scaleX(-1)}
+.kiss-burst{position:absolute;z-index:3;left:50%;top:33%;transform:translate(-50%,-50%);width:8rem;height:8rem;color:#ee6680;pointer-events:none}
+.kiss-burst span{position:absolute;left:37%;top:28%;font-size:3.8rem}.kiss-burst i{position:absolute;left:4%;top:8%;color:#f4c36f;font-size:2rem}.kiss-burst b{position:absolute;right:3%;bottom:5%;font-size:1.8rem}
+.wish-grid{grid-template-columns:1fr}
+@media(min-width:700px){.wish-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
+@media(min-width:1200px){.wish-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
+@media(max-width:600px){.rings-photo{top:13%;width:100vw}.intro__copy{margin-top:14rem}.kiss-stage{width:118vw;height:24rem}.anime-character img{width:17rem}.kiss-burst{top:36%;transform:translate(-50%,-50%) scale(.72)}}
